# Copy to bridge.env (git-ignored), fill in your values, then:
#   set -a; . ./bridge.env; set +a

# ── mesh identity ──────────────────────────────────────────────────────────
# SSH target for the worker. Use the MagicDNS name once it resolves.
BRIDGE_WORKER_SSH=user@worker-1
# Mesh address and DNS name (example values; replace with yours)
BRIDGE_WORKER_IP=100.64.0.10
BRIDGE_WORKER_DNS=worker-1.<tailnet>.ts.net

# ── exchange ───────────────────────────────────────────────────────────────
BRIDGE_LOCAL_DIR=$HOME/.openclaw/exchange
BRIDGE_REMOTE_DIR=/home/user/exchange
BRIDGE_ORCHESTRATOR=orchestrator

# ── model server (tailnet HTTPS) ───────────────────────────────────────────
# The worker's OpenAI-compatible endpoint. Empty disables the check.
BRIDGE_OLLAMA_URL=https://worker-1.<tailnet>.ts.net:8446/v1

# ── agent dashboard (tailnet HTTPS, optional) ──────────────────────────────
BRIDGE_AGENT_URL=https://worker-1.<tailnet>.ts.net:8443

# WASP-compatible dashboard credentials (leave empty to disable the worker).
# Never commit a real password; keep this file at mode 600.
WASP_BASE_URL=https://worker-1.<tailnet>.ts.net:8443
WASP_USER=admin
WASP_PASSWORD=

# ── FreeCAD MCP (optional) ────────────────────────────────────────────────
FREECAD_REMOTE=user@worker-1
FREECAD_RPC_PORT=9875
